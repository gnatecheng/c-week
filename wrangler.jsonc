{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "etai",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // Create in Cloudflare dashboard: D1 → Create → name "etai-access-log" → copy database_id below.
  // Apply schema: wrangler d1 execute etai-access-log --remote --file=./migrations/0001_access_log.sql
  // Until database_id is set, remove this block or leave binding unset locally; the Worker skips logging when ACCESS_LOG is missing.
  "d1_databases": [
    {
      "binding": "ACCESS_LOG",
      "database_name": "etai-access-log",
      "database_id": "00000000-0000-0000-0000-000000000001"
    }
  ]
}
